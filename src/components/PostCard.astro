---
// src/components/PostCard.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, categories, tags, summary, cover } = post.data;
const href = `/posts/${post.id}/`;
const isLocked = categories.includes('手记');
---

<article class="group relative bg-warm-50 dark:bg-warm-850 rounded-xl shadow-sm hover:shadow-md border border-warm-200 dark:border-warm-700 overflow-hidden transition-all duration-200">
  {isLocked && (
    <button
      id={`lock-btn-${post.id}`}
      class="lock-btn absolute top-3 right-3 z-10 w-7 h-7 rounded-full bg-warm-100/80 dark:bg-warm-800/80 backdrop-blur-sm flex items-center justify-center cursor-pointer hover:bg-warm-200 dark:hover:bg-warm-700 transition-colors"
      aria-label="加密状态"
    >
      <svg class="lock-icon-locked w-3.5 h-3.5 text-warm-500 dark:text-warm-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
      </svg>
      <svg class="lock-icon-unlocked w-3.5 h-3.5 text-warm-600 dark:text-warm-300 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5V6.75a4.5 4.5 0 119 0v3.75M3.75 21.75h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H3.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
      </svg>
    </button>
  )}
  {cover && (
    <div class="block aspect-[16/9] overflow-hidden">
      <img src={cover} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
    </div>
  )}
  <div class="p-6">
    <div class="flex items-center gap-3 text-xs text-warm-500 dark:text-warm-400 mb-3">
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      {categories.length > 0 && (
        <span class="flex items-center gap-1">
          <span class="text-warm-300">·</span>
          {categories.map(cat => (
            <a href={`/categories/${cat}/`} class="relative z-10 hover:text-warm-600 dark:hover:text-warm-200 transition-colors">
              {cat}
            </a>
          ))}
        </span>
      )}
    </div>
    <h2 class="text-xl font-bold font-[family-name:var(--font-serif)] text-warm-800 dark:text-warm-100 mb-2 group-hover:text-warm-600 dark:group-hover:text-warm-300 transition-colors">
      <a href={href} class="after:absolute after:inset-0">{title}</a>
    </h2>
    {summary && (
      <p class="text-sm text-warm-500 dark:text-warm-400 leading-relaxed mb-3 line-clamp-2">{summary}</p>
    )}
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {tags.map(tag => (
          <a href={`/tags/${tag}/`} class="relative z-10 text-xs px-2 py-0.5 rounded-full bg-warm-100 dark:bg-warm-700 text-warm-600 dark:text-warm-300 hover:bg-warm-200 dark:hover:bg-warm-600 transition-colors">
            #{tag}
          </a>
        ))}
      </div>
    )}
  </div>
</article>

{isLocked && (
  <script>
    (function() {
      const btn = document.getElementById(`lock-btn-${post.id}`);
      if (!btn) return;

      const lockedIcon = btn.querySelector('.lock-icon-locked');
      const unlockedIcon = btn.querySelector('.lock-icon-unlocked');
      const UNLOCK_KEY = 'handnote-unlocked';

      // 刷新浏览器 → 清除解锁状态
      const navType = performance.getEntriesByType('navigation')[0]?.type;
      if (navType === 'reload') {
        sessionStorage.removeItem(UNLOCK_KEY);
      }

      function updateIcon() {
        if (sessionStorage.getItem(UNLOCK_KEY) === 'true') {
          lockedIcon.classList.add('hidden');
          unlockedIcon.classList.remove('hidden');
        } else {
          lockedIcon.classList.remove('hidden');
          unlockedIcon.classList.add('hidden');
        }
      }

      updateIcon();

      // 监听其他卡片/PasswordGate 触发的状态变化
      window.addEventListener('handnote-lock-changed', updateIcon);

      // 从文章页返回（bfcache 恢复）+ 页面可见时重新检查
      window.addEventListener('pageshow', updateIcon);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') updateIcon();
      });

      btn.addEventListener('click', (e) => {
        // 仅在已解锁状态下拦截点击 — 执行上锁
        if (sessionStorage.getItem(UNLOCK_KEY) === 'true') {
          e.preventDefault();
          e.stopPropagation();
          sessionStorage.removeItem(UNLOCK_KEY);
          window.dispatchEvent(new CustomEvent('handnote-lock-changed'));
        }
        // 锁定状态下不拦截，事件冒泡到 stretched link 正常跳转
      });
    })();
  </script>
)}
