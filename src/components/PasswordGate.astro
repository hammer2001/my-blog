---
// src/components/PasswordGate.astro — 手记分类密码保护弹窗
const PASSWORD_HASH = '60f20d3a207c9c9dc90305ac05f26d3877e73e9023c0596bc5d3f9ef17b72fd9';
---

<script>
  async function sha256(message: string) {
    const msgBuffer = new TextEncoder().encode(message);
    const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
  }

  const UNLOCK_KEY = 'handnote-unlocked';
  const PASSWORD_HASH = '60f20d3a207c9c9dc90305ac05f26d3877e73e9023c0596bc5d3f9ef17b72fd9';

  // 刷新浏览器 → 清除解锁状态（使用新旧两种 API 确保兼容）
  const isReload = (function() {
    try {
      const nav = performance.getEntriesByType('navigation')[0];
      if (nav && nav.type === 'reload') return true;
    } catch(e) {}
    try {
      if (typeof performance.navigation !== 'undefined' && performance.navigation.type === 1) return true;
    } catch(e) {}
    return false;
  })();

  if (isReload) {
    sessionStorage.removeItem(UNLOCK_KEY);
  }

  // 已解锁则跳过，不构建弹窗
  if (sessionStorage.getItem(UNLOCK_KEY) !== 'true') {
    buildOverlay();
  }

  function buildOverlay() {
    const style = document.createElement('style');
    style.textContent = `
      .pw-overlay {
        position: fixed; inset: 0; z-index: 9999;
        display: flex; align-items: center; justify-content: center;
        background: rgba(254, 249, 240, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }
      .dark .pw-overlay { background: rgba(74, 32, 24, 0.92); }
      .pw-icon {
        width: 56px; height: 56px; margin: 0 auto 1.25rem;
        background: #fdf2e0; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
      }
      .dark .pw-icon { background: #6d3424; }
      .pw-title { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 700; color: #4a2018; margin-bottom: 0.25rem; }
      .dark .pw-title { color: #fdf2e0; }
      .pw-desc { font-size: 0.875rem; color: #c4754b; margin-bottom: 1.5rem; }
      .dark .pw-desc { color: #d4a574; }
      .pw-row { display: flex; gap: 0.5rem; }
      .pw-input {
        flex: 1; padding: 0.625rem 1rem;
        border: 1px solid #f5e6d3; border-radius: 0.75rem;
        background: #fef9f0; outline: none;
        font-size: 0.875rem; color: #4a2018;
        transition: border-color 0.2s;
      }
      .dark .pw-input { background: #4a2018; border-color: #6d3424; color: #fef9f0; }
      .pw-input:focus { border-color: #c4754b; }
      .pw-btn {
        padding: 0.625rem 1.25rem; border-radius: 0.75rem;
        background: #c4754b; color: #fff; font-size: 0.875rem;
        font-weight: 500; border: none; cursor: pointer;
        transition: background 0.2s;
      }
      .pw-btn:hover { background: #a85a3a; }
      .pw-error { font-size: 0.75rem; color: #dc2626; margin-top: 0.75rem; display: none; }
      .pw-card {
        position: relative;
        background: #fff;
        border: 1px solid #f5e6d3;
        border-radius: 1.25rem;
        padding: 2.5rem 2rem;
        max-width: 360px; width: 90%;
        text-align: center;
        box-shadow: 0 20px 60px -12px rgba(0,0,0,0.08), 0 1px 2px rgba(0,0,0,0.04);
      }
      .dark .pw-card { background: #573023; border-color: #6d3424; }
      .pw-close {
        position: absolute; top: 0.75rem; right: 0.875rem;
        width: 28px; height: 28px;
        border: none; background: none;
        cursor: pointer; color: #c4754b;
        display: flex; align-items: center; justify-content: center;
        border-radius: 0.5rem; font-size: 1rem;
        transition: background 0.15s;
      }
      .pw-close:hover { background: #fdf2e0; }
      .dark .pw-close:hover { background: #6d3424; }
    `;
    document.head.appendChild(style);

    const overlay = document.createElement('div');
    overlay.className = 'pw-overlay';
    overlay.id = 'pw-overlay';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-label', '密码验证');
    overlay.innerHTML = `
      <div class="pw-card">
        <button class="pw-close" aria-label="关闭">&times;</button>
        <div class="pw-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#c4754b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0110 0v4"/>
            <circle cx="12" cy="16" r="1" fill="#c4754b" stroke="none"/>
          </svg>
        </div>
        <div class="pw-title">需要密码</div>
        <div class="pw-desc">此内容已加密，请输入密码查看</div>
        <form class="pw-row">
          <input class="pw-input" type="password" placeholder="输入密码" autofocus />
          <button class="pw-btn" type="submit">确认</button>
        </form>
        <p class="pw-error">密码错误，请重试</p>
      </div>
    `;

    document.body.appendChild(overlay);

    const input = overlay.querySelector('.pw-input') as HTMLInputElement;
    const form = overlay.querySelector('form')!;
    const errorEl = overlay.querySelector('.pw-error') as HTMLElement;
    const closeBtn = overlay.querySelector('.pw-close')!;

    document.body.style.overflow = 'hidden';

    function goBack() {
      history.back();
    }

    function onEsc(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        cleanup();
        goBack();
      }
    }
    document.addEventListener('keydown', onEsc);

    function cleanup() {
      document.removeEventListener('keydown', onEsc);
      document.body.style.overflow = '';
    }

    closeBtn.addEventListener('click', () => { cleanup(); goBack(); });

    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) { cleanup(); goBack(); }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const hash = await sha256(input.value);
      if (hash === PASSWORD_HASH) {
        sessionStorage.setItem(UNLOCK_KEY, 'true');
        window.dispatchEvent(new CustomEvent('handnote-lock-changed'));
        overlay.remove();
        cleanup();
      } else {
        errorEl.style.display = 'block';
        input.value = '';
        input.focus();
        input.style.borderColor = '#dc2626';
        setTimeout(() => { input.style.borderColor = ''; }, 1000);
      }
    });
  }
</script>
