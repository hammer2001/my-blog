---
// src/components/ThemeToggle.astro
---

<button
  type="button"
  aria-label="切换深色模式"
  class="theme-toggle-btn p-2 rounded-lg hover:bg-warm-200 dark:hover:bg-warm-700 transition-colors cursor-pointer"
>
  <!-- 太阳图标（亮色模式时显示） -->
  <svg class="theme-icon-sun w-5 h-5 block dark:hidden text-warm-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <!-- 月亮图标（暗色模式时显示） -->
  <svg class="theme-icon-moon w-5 h-5 hidden dark:block text-warm-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<script>
  // 使用 class 选择器，支持页面中多个实例
  function initThemeToggle() {
    const buttons = document.querySelectorAll('.theme-toggle-btn');
    if (buttons.length === 0) return;

    const html = document.documentElement;

    // 初始化（只需执行一次）
    const stored = localStorage.getItem('theme');
    if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      html.classList.add('dark');
    }

    // 给所有按钮绑定事件
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        html.classList.toggle('dark');
        const isDark = html.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    });
  }

  initThemeToggle();
</script>
