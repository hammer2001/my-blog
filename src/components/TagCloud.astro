---
// src/components/TagCloud.astro
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const tagMap = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  }
}
const tags = [...tagMap.entries()].sort((a, b) => a[0].localeCompare(b[0]));
const maxCount = Math.max(...tags.map(([, c]) => c), 1);

function hash(str: string) {
  let h = 0;
  for (let i = 0; i < str.length; i++) h = (h * 31 + str.charCodeAt(i)) | 0;
  return Math.abs(h);
}

// 四行分配
const rows: [string, number][][] = [[], [], [], []];
tags.forEach((t, i) => rows[i % 4].push(t));
---

<div class="space-y-4 py-6">
  {rows.map((row, ri) => (
    <div class="flex flex-wrap justify-center items-start gap-x-4 gap-y-1">
      {row.map(([name, count]) => {
        const ratio = count / maxCount;
        const size = 0.8 + ratio * 0.9;
        const opacity = 0.45 + ratio * 0.55;
        const h = hash(name + ri);
        const mt = ((h % 12) - 4);
        const duration = 7 + (h % 8);
        const delay = (h % 6000) / 1000;
        return (
          <span
            class="tag-cloud-item"
            style={{
              fontSize: `${size}rem`,
              opacity,
              marginTop: `${mt}px`,
              animationDuration: `${duration}s`,
              animationDelay: `${delay}s`,
            }}
          >
            <a
              href={`/tags/${name}/`}
              class="text-warm-600 dark:text-warm-300 hover:text-warm-800 dark:hover:text-warm-100 transition-colors duration-200 font-[family-name:var(--font-body)]"
            >
              {name}
            </a>
          </span>
        );
      })}
    </div>
  ))}
</div>

<style is:global>
  @keyframes tagSway {
    0%   { transform: translate(0, 0) rotate(0deg); }
    12%  { transform: translate(-2px, -3px) rotate(0.3deg); }
    28%  { transform: translate(3px, 1px) rotate(-0.2deg); }
    44%  { transform: translate(-1px, 4px) rotate(0.4deg); }
    62%  { transform: translate(2px, -2px) rotate(-0.3deg); }
    78%  { transform: translate(-3px, -1px) rotate(0.1deg); }
    100% { transform: translate(0, 0) rotate(0deg); }
  }
  .tag-cloud-item {
    display: inline-block;
    animation: tagSway 8s ease-in-out infinite;
  }
  .tag-cloud-item:hover {
    animation-play-state: paused;
  }
</style>
